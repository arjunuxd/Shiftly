rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Fail-closed default: deny all access unless explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // profiles/{uid}
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // verifications/{uid}
    match /verifications/{uid} {
      allow read, write: if false;
    }

    // vendorProfiles/{uid}
    match /vendorProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // jobs/{jobId}
    // Client direct reads are denied; job access is controlled via the server API.
    // Vendors manage jobs through the server API only.
    match /jobs/{jobId} {
      allow read, write: if false;
    }

    // applications/{applicationId}
    // Application ID format: {jobId}_{jobSeekerId}
    // Job Seekers can read their own applications.
    // Job Seekers can create their own applications (validated server-side).
    // Job Seekers can update their own applications (withdraw only, validated server-side).
    // All writes go through the server API.
    match /applications/{applicationId} {
      allow read: if request.auth != null
        && applicationId.matches(".*_" + request.auth.uid + "$");
      allow create: if request.auth != null
        && request.resource.data.jobSeekerId == request.auth.uid
        && request.resource.data.keys().hasAll(["jobId", "jobSeekerId", "vendorId", "status", "createdAt", "updatedAt"])
        && request.resource.data.status == "applied";
      allow update: if request.auth != null
        && applicationId.matches(".*_" + request.auth.uid + "$")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "withdrawn";
      allow delete: if false;
    }
  }
}
