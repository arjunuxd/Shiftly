rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Fail-closed default: deny all access unless explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // profiles/{uid}
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // verifications/{uid}
    match /verifications/{uid} {
      allow read, write: if false;
    }

    // vendorProfiles/{uid}
    match /vendorProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // jobs/{jobId}
    match /jobs/{jobId} {
      allow read, write: if false;
    }

    // applications/{applicationId}
    match /applications/{applicationId} {
      allow read: if request.auth != null
        && (applicationId.matches(".*_" + request.auth.uid + "$")
            || resource.data.vendorId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.jobSeekerId == request.auth.uid
        && request.resource.data.keys().hasAll(["jobId", "jobSeekerId", "vendorId", "status", "createdAt", "updatedAt"])
        && request.resource.data.status == "applied";
      allow update: if request.auth != null
        && (applicationId.matches(".*_" + request.auth.uid + "$")
            || resource.data.vendorId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);
      allow delete: if false;
    }

    // conversations/{conversationId}
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (resource.data.participantVendorId == request.auth.uid
            || resource.data.participantJobSeekerId == request.auth.uid);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantVendorId == request.auth.uid
              || get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantJobSeekerId == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(["senderId", "text", "createdAt"])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
