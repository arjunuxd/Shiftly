# Shiftly Backend Environment Variables
# Copy this file to server/.env and fill in your values.
# NEVER commit real values. Only placeholders live here.

# Server
PORT=4000
NODE_ENV=development

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Firebase Admin SDK (server-only credentials)
# Point this to your service-account JSON file located OUTSIDE the repository.
# Example: GOOGLE_APPLICATION_CREDENTIALS=C:/secrets/shiftly-service-account.json
# The file is never committed and is never exposed to the frontend.
GOOGLE_APPLICATION_CREDENTIALS=
